class Solution(object):
    def minimumAbsDifference(self, arr):
        arr.sort()
        lst = []
        min = float('inf')
        for i in range(1,len(arr)):
          diff = abs(arr[i] - arr[i - 1])
          if diff < min:
            min = diff
            lst = [ [ arr[i-1],arr[i]] ]
          elif diff == min:
            lst.append([arr[i-1],arr[i]])
        return lst
